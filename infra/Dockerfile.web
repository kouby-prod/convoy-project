# syntax=docker/dockerfile:1
# Build context = repo root:  docker build -f infra/Dockerfile.web .
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

# ---- install workspace deps ----
FROM base AS deps
COPY pnpm-workspace.yaml package.json .npmrc ./
COPY pnpm-lock.yaml* ./
COPY apps/web/package.json apps/web/package.json
# @carpool/api-client depends on @carpool/api (workspace:*), and the web build
# typechecks that transitive source once it imports the typed client, so the api
# manifest must be present for pnpm to provision it.
COPY apps/api/package.json apps/api/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/schemas/package.json packages/schemas/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/api-client/package.json packages/api-client/package.json
RUN pnpm install --frozen-lockfile

# ---- build Next.js ----
FROM deps AS build
COPY . .
# NEXT_PUBLIC_* is inlined at build time; override at build with --build-arg.
ARG NEXT_PUBLIC_API_URL=http://localhost:3001
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
ENV NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=$NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_PAYPAL_CLIENT_ID=
ENV NEXT_PUBLIC_PAYPAL_CLIENT_ID=$NEXT_PUBLIC_PAYPAL_CLIENT_ID
ARG NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=
ENV NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=$NEXT_PUBLIC_GOOGLE_AUTH_ENABLED
RUN pnpm --filter @carpool/web build

# ---- runtime (full workspace kept; runs `next start`) ----
FROM build AS runner
ENV NODE_ENV=production
WORKDIR /app/apps/web
EXPOSE 3000
CMD ["pnpm", "start"]
