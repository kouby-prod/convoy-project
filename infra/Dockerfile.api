# syntax=docker/dockerfile:1
# Build context = repo root:  docker build -f infra/Dockerfile.api .
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

# ---- install workspace deps (cached on manifests) ----
FROM base AS deps
COPY pnpm-workspace.yaml package.json .npmrc ./
COPY pnpm-lock.yaml* ./
COPY apps/api/package.json apps/api/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/schemas/package.json packages/schemas/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/api-client/package.json packages/api-client/package.json
RUN pnpm install --frozen-lockfile

# ---- build (tsup bundles the @carpool/* workspace packages into dist) ----
FROM deps AS build
COPY . .
RUN pnpm --filter @carpool/api build

# ---- runtime ----
FROM base AS runner
ENV NODE_ENV=production
# External runtime deps (hono, drizzle, pg, …) stay in the hoisted node_modules.
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/api/dist ./dist
COPY --from=build /app/apps/api/drizzle ./drizzle
COPY --from=build /app/apps/api/package.json ./package.json
EXPOSE 3001
# Default: serve traffic. Compose `api-migrate` overrides this with
# `node dist/migrate.js` so schema changes apply before the API starts.
CMD ["node", "dist/server.js"]
