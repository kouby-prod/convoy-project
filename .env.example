# =============================================================================
# SINGLE SOURCE OF TRUTH for the whole monorepo (Docker services + infra).
# Copy this file to `.env` at the repo root (it is gitignored) and fill it in.
#
#   cp .env.example .env
#
# docker compose reads every value from here (see docker-compose.yml and
# infra/docker-compose.infra.yml). Nothing is hard-coded in the compose files.
# =============================================================================

# --- PostgreSQL (the `postgres` service + DB credentials) ---
POSTGRES_USER=carpool
POSTGRES_PASSWORD=carpool
POSTGRES_DB=carpool
POSTGRES_PORT=5433

# --- Redis (BullMQ + WebSocket pub/sub) ---
REDIS_PORT=6379
# Host-side URL — API on your machine reaches the published redis port.
REDIS_URL=redis://localhost:6379
# Container-side URL — the api container reaches Redis via the service name.
DOCKER_REDIS_URL=redis://redis:6379

# --- Object storage: MinIO, S3-compatible (driver identity documents) ---
S3_PORT=9000
S3_CONSOLE_PORT=9001
# MinIO root credentials. The secret must be at least 8 characters.
S3_ACCESS_KEY=carpool
S3_SECRET_KEY=carpool-secret
S3_BUCKET=carpool-documents
S3_REGION=us-east-1
# Host-side endpoint — how the API reaches MinIO when it runs on YOUR machine.
S3_ENDPOINT=http://localhost:9000
# Container-side endpoint — the api container reaches MinIO by service name.
# Mirrors the DATABASE_URL / DOCKER_DATABASE_URL pair below.
DOCKER_S3_ENDPOINT=http://minio:9000
# The host baked into presigned upload/view URLs. The BROWSER follows those URLs,
# so this must stay resolvable from the browser (localhost) even in Docker, where
# `minio` is only a compose-network name.
S3_PUBLIC_ENDPOINT=http://localhost:9000
# Origins allowed to upload straight to the bucket. '*' is fine for local dev;
# in production narrow it to the web origin.
S3_CORS_ALLOW_ORIGIN=*
# Lifetime of a presigned upload/view URL, in seconds.
S3_URL_TTL=300

# --- Object storage: MinIO, S3-compatible (driver identity documents) ---
S3_PORT=9000
S3_CONSOLE_PORT=9001
# MinIO root credentials. The secret must be at least 8 characters.
S3_ACCESS_KEY=carpool
S3_SECRET_KEY=carpool-secret
S3_BUCKET=carpool-documents
S3_REGION=us-east-1
# Host-side endpoint — how the API reaches MinIO when it runs on YOUR machine.
S3_ENDPOINT=http://localhost:9000
# Container-side endpoint — the api container reaches MinIO by service name.
# Mirrors the DATABASE_URL / DOCKER_DATABASE_URL pair below.
DOCKER_S3_ENDPOINT=http://minio:9000
# The host baked into presigned upload/view URLs. The BROWSER follows those URLs,
# so this must stay resolvable from the browser (localhost) even in Docker, where
# `minio` is only a compose-network name.
S3_PUBLIC_ENDPOINT=http://localhost:9000
# Origins allowed to upload straight to the bucket. '*' is fine for local dev;
# in production narrow it to the web origin.
S3_CORS_ALLOW_ORIGIN=*
# Lifetime of a presigned upload/view URL, in seconds.
S3_URL_TTL=300

# --- API (apps/api) ---
API_PORT=3001
# Host-side URL — used by drizzle migrate/generate run on YOUR machine.
DATABASE_URL=postgres://carpool:carpool@localhost:5433/carpool
# Container-side URL — the api container reaches Postgres via the service name.
# Keep credentials/db in sync with the POSTGRES_* values above.
DOCKER_DATABASE_URL=postgres://carpool:carpool@postgres:5432/carpool
# REQUIRED, must be >= 32 chars. Generate with:  openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-strong-32+-char-secret
BETTER_AUTH_URL=http://localhost:3001
# Comma-separated origins allowed to make credentialed auth requests. The first
# entry is also used as the web app URL in notification emails.
TRUSTED_ORIGINS=http://localhost:3000,http://localhost:3001
# Google OAuth (web redirect flow). Optional — set BOTH to enable "Sign in with
# Google". From Google Cloud Console → Credentials → OAuth 2.0 Client ID (Web).
# Register this authorized redirect URI: http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Docker inlines GOOGLE_CLIENT_ID into the web bundle as the "show Google button"
# flag (the client id is public). Leave both empty to hide the button.
# Email "From" address.
EMAIL_FROM=no-reply@carpool.local
# Support inbox the /contact form forwards to. Optional — falls back to
# EMAIL_FROM when unset.
SUPPORT_EMAIL=
# SMTP transport. Leave SMTP_HOST EMPTY to use the dev console stub (the
# verification/reset link is printed to the API logs). Set it to send real email.
# Local inbox option: run Mailpit (docker run -p 1025:1025 -p 8025:8025 axllent/mailpit)
# then set SMTP_HOST=localhost and SMTP_PORT=1025, and open http://localhost:8025
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 'true' for TLS-on-connect (port 465); otherwise leave as false (STARTTLS/none).
SMTP_SECURE=false
# SMS sender. Display label for the console stub.
SMS_FROM=Carpool
# Self-hosted SMS gateway (SMSGate "Local mode" on an Android phone — no Firebase).
# Leave SMS_GATEWAY_URL EMPTY to use the dev console stub (OTP printed to API logs).
# To send real SMS: set it to the phone's LAN address shown in the SMSGate app
# (e.g. http://192.168.1.50:8080) plus the Basic-auth username/password it shows.
# The phone must be on the same network as wherever the API runs.
SMS_GATEWAY_URL=
SMS_GATEWAY_USER=
SMS_GATEWAY_PASSWORD=

# --- Web (apps/web) ---
WEB_PORT=3000
# Browser-side base URL — inlined into the bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:3001
# Optional override for the messages WebSocket. When unset, the web app derives
# ws(s)://<api-host>/ws/messages from NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_WS_URL=ws://localhost:3001/ws/messages
# Server-side (SSR) base URL. On the host it matches the public one; in Docker
# the web container reaches the API by service name, not via its own localhost.
# Mirrors the DATABASE_URL / DOCKER_DATABASE_URL pair above.
INTERNAL_API_URL=http://localhost:3001
DOCKER_INTERNAL_API_URL=http://api:3001

# --- Mobile (apps/mobile) ---
EXPO_PORT=8081
EXPO_PUBLIC_API_URL=http://localhost:3001

# --- Payments (optional — leave empty to boot without a provider) ---
# Stripe Dashboard (test mode) → Developers → API keys
#   STRIPE_SECRET_KEY                 sk_test_...
#   NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY pk_test_...
# Local webhooks (Stripe CLI, keep this running while you pay):
#   stripe listen --forward-to localhost:3001/webhooks/stripe --events payment_intent.succeeded,payment_intent.processing,payment_intent.requires_action,payment_intent.payment_failed,charge.dispute.created,charge.dispute.closed
# then paste the printed whsec_... here:
#   STRIPE_WEBHOOK_SECRET=whsec_...
# Events used: payment_intent.succeeded, payment_intent.processing,
# payment_intent.requires_action (3-D Secure), payment_intent.payment_failed,
# charge.dispute.created, charge.dispute.closed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Currencies this account is allowed to charge in (comma-separated, lowercase).
# PaymentIntent creation is rejected before calling Stripe if inv.currency isn't
# in this list.
STRIPE_ALLOWED_CURRENCIES=cad
# Override for PaymentIntent `payment_method_types` (comma-separated, e.g.
# "card,acss_debit"). Leave empty to let Stripe pick methods dynamically via
# `automatic_payment_methods` — except for saved-card (off-session) charges,
# which fall back to "card" only in code until Dashboard Settings > Payment
# methods is confirmed to have a method that supports off-session reuse
# enabled in both test and live mode. See PAYMENT_METHOD_TYPES_FALLBACK in
# apps/api/src/modules/payment/stripe.ts.
STRIPE_PAYMENT_METHOD_TYPES=
# PayPal Developer Dashboard → sandbox app
#   PAYPAL_CLIENT_ID / PAYPAL_CLIENT_SECRET  (REST API credentials)
#   NEXT_PUBLIC_PAYPAL_CLIENT_ID             (same client id as above)
#   PAYPAL_WEBHOOK_ID                        (Webhooks → id of the listener)
# Webhook URL: https://<public-host>/webhooks/paypal
# Events: CHECKOUT.ORDER.COMPLETED, PAYMENT.CAPTURE.COMPLETED, CHECKOUT.ORDER.DECLINED
# localhost is not reachable from PayPal — use ngrok/Cloudflare Tunnel in dev.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_MODE=sandbox
INVOICE_LEGAL_NAME=Kouby
INVOICE_ADDRESS=
INVOICE_GST_NUMBER=
INVOICE_QST_NUMBER=
# Quebec: TPS 5 % + TVQ 9,975 % on the 4 CAD commission only (fare is untaxed).
TAX_MODE=gst_qst
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# --- Observability: GlitchTip (errors) + ntfy (pages) ---
# GlitchTip is Sentry-API compatible. After first `pnpm docker:up`, open
# GLITCHTIP_DOMAIN, register, create org + project "kouby", then paste the DSN.
# Host process uses localhost; containers must use the compose hostname.
GLITCHTIP_PORT=8000
GLITCHTIP_DOMAIN=http://localhost:8000
GLITCHTIP_ENABLE_REGISTRATION=true
# Optional Django secret. Leave unset to reuse BETTER_AUTH_SECRET. Do not set an
# empty value — compose would pass a blank SECRET_KEY.
# GLITCHTIP_SECRET_KEY=
DOCKER_GLITCHTIP_DATABASE_URL=postgres://carpool:carpool@postgres:5432/glitchtip
DOCKER_GLITCHTIP_REDIS_URL=redis://redis:6379/2
# After creating the project: copy DSN, then duplicate it with host `glitchtip:8000`.
# Example: http://<key>@localhost:8000/1  and  http://<key>@glitchtip:8000/1
SENTRY_DSN=
DOCKER_SENTRY_DSN=
SENTRY_ENVIRONMENT=development
# ntfy: POST to NTFY_URL/NTFY_TOPIC. Subscribe in the ntfy app (topic must match).
# Pick an unguessable topic — anyone who knows it can read the stream.
NTFY_PORT=2586
NTFY_PUBLIC_URL=http://localhost:2586
NTFY_URL=http://localhost:2586
DOCKER_NTFY_URL=http://ntfy
NTFY_TOPIC=change-me-kouby-payments
NTFY_TOKEN=
# Optional leftover. Empty = unused (ntfy is the pager).
PAGERDUTY_ROUTING_KEY=
# Host `pnpm --filter @carpool/api dev` keeps workers in-process (default true).
# Docker Compose sets this to false on `api` and runs `payment-worker` instead.
# PAYMENT_WORKER_EMBEDDED=true
