# syntax=docker/dockerfile:1
# Production web image. Build context = repo root:
#   docker build -f Dockerfile.web --build-arg NEXT_PUBLIC_API_URL=https://api.example.com .
FROM node:22-alpine AS base
RUN corepack enable
WORKDIR /app

# ---- install workspace deps (build needs typescript / Next) ----
FROM base AS deps
COPY pnpm-workspace.yaml package.json .npmrc ./
COPY pnpm-lock.yaml* ./
COPY apps/web/package.json apps/web/package.json
# @carpool/api-client typechecks against @carpool/api, so the api manifest
# must be present for pnpm to provision the workspace.
COPY apps/api/package.json apps/api/package.json
COPY packages/config/package.json packages/config/package.json
COPY packages/schemas/package.json packages/schemas/package.json
COPY packages/core/package.json packages/core/package.json
COPY packages/api-client/package.json packages/api-client/package.json
RUN pnpm install --frozen-lockfile

# ---- build Next.js (NEXT_PUBLIC_* is inlined here) ----
FROM deps AS build
COPY . .
ARG NEXT_PUBLIC_API_URL=http://localhost:3001
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
ENV NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=$NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY
ARG NEXT_PUBLIC_PAYPAL_CLIENT_ID=
ENV NEXT_PUBLIC_PAYPAL_CLIENT_ID=$NEXT_PUBLIC_PAYPAL_CLIENT_ID
ARG NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=
ENV NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=$NEXT_PUBLIC_GOOGLE_AUTH_ENABLED
RUN pnpm --filter @carpool/web build

# ---- runtime ----
# next.config.ts imports `dotenv` (a web *devDependency*) when `next start`
# loads config, so a --prod install would crash at boot. We copy the build
# install but not the app source tree, except files Next reads at runtime.
FROM base AS runner
ENV NODE_ENV=production
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/package.json ./package.json
COPY --from=build --chown=node:node /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=build --chown=node:node /app/.npmrc ./.npmrc
COPY --from=build --chown=node:node /app/apps/web/package.json ./apps/web/package.json
COPY --from=build --chown=node:node /app/apps/web/.next ./apps/web/.next
COPY --from=build --chown=node:node /app/apps/web/public ./apps/web/public
COPY --from=build --chown=node:node /app/apps/web/next.config.ts ./apps/web/next.config.ts
COPY --from=build --chown=node:node /app/apps/web/messages ./apps/web/messages
COPY --from=build --chown=node:node /app/apps/web/src/i18n ./apps/web/src/i18n
COPY --from=build --chown=node:node /app/packages/schemas ./packages/schemas
COPY --from=build --chown=node:node /app/packages/api-client ./packages/api-client
COPY --from=build --chown=node:node /app/packages/core ./packages/core
COPY --from=build --chown=node:node /app/packages/config ./packages/config
COPY --from=build --chown=node:node /app/apps/api/package.json ./apps/api/package.json
USER node
WORKDIR /app/apps/web
EXPOSE 3000
CMD ["pnpm", "start"]
