# Expo / React Native and Metro resolve native modules from a flat layout.
# node-linker=hoisted keeps a single, predictable node_modules tree which is the
# most reliable setup for an Expo managed app inside a pnpm monorepo.
node-linker=hoisted
# Allow the Expo/RN/Next toolchains to run their lifecycle scripts on install.
enable-pre-post-scripts=true
# Keep the lockfile honest in CI.
strict-peer-dependencies=false
