# --- apps/mobile environment ---
# Copy to .env. Validated by Zod (lib/env.ts).
# EXPO_PUBLIC_* values are inlined into the app bundle at build time.
#
# NOTE: on a physical device, localhost points at the phone, not your machine.
# Use your computer's LAN IP, e.g. http://192.168.1.20:3001
EXPO_PUBLIC_API_URL=http://localhost:3001
