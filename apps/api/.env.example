# --- apps/api environment ---
# Copy to .env and adjust. Validated by Zod at boot (src/env.ts); the API
# refuses to start if anything here is missing or malformed.

# Port the Hono server listens on.
PORT=3001

# PostgreSQL connection string used by Drizzle.
# Matches the docker-compose 'postgres' service defaults.
DATABASE_URL=postgres://carpool:carpool@localhost:5432/carpool
