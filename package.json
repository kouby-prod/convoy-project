{
  "name": "carpool",
  "version": "0.0.0",
  "private": true,
  "description": "Carpooling marketplace monorepo (web + iOS + Android + Hono backend) — base skeleton",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "db:generate": "pnpm --filter @carpool/api db:generate",
    "db:migrate": "pnpm --filter @carpool/api db:migrate",
    "clean": "turbo run clean && rimraf node_modules"
  },
  "devDependencies": {
    "prettier": "3.8.4",
    "rimraf": "6.0.1",
    "turbo": "2.9.18",
    "typescript": "6.0.3"
  }
}
